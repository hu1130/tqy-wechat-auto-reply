# LLM settings
LLM_PROVIDER=ollama
LLM_MODEL=deepseek-r1:14b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
REQUEST_TIMEOUT=120

# WeChat bot settings
WECHAT_LISTEN_CHATS=文件传输助手
WECHAT_SELF_NAMES=
MAX_CONTEXT_MESSAGES=8
DEDUP_WINDOW_SECONDS=60
DRY_RUN=1

# Reply style
SYSTEM_PROMPT=你是一个微信聊天助手。请根据最近上下文，生成自然、简短、像真人发送的中文回复。只输出回复正文，不要解释，不要加引号，不要输出思考过程。

