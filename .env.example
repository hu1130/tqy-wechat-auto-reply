# LLM settings
# Supported: ollama, openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=deepseek-r1:14b
OLLAMA_BASE_URL=http://localhost:11434

# Used only when LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
REQUEST_TIMEOUT=120
API_RETRY_ATTEMPTS=4
API_RETRY_BASE_DELAY_SECONDS=1
API_RETRY_MAX_DELAY_SECONDS=30
API_CIRCUIT_FAILURE_THRESHOLD=5
API_CIRCUIT_RECOVERY_SECONDS=60
API_MIN_INTERVAL_SECONDS=0.2

# WeChat bot settings
# Multiple chats can be separated by comma, for example: 文件传输助手,测试群
WECHAT_LISTEN_CHATS=文件传输助手

# Optional. Put your own WeChat display names here to avoid replying to yourself.
WECHAT_SELF_NAMES=
MAX_CONTEXT_MESSAGES=8
MESSAGE_BUFFER_SECONDS=3
OPERATOR_IDLE_GUARD_SECONDS=2
WECHAT_AUTO_ACTIVATE_WINDOW_ENABLED=1
WECHAT_AUTO_ACTIVATE_INTERVAL_SECONDS=3
WECHAT_RECONNECT_FAILURE_THRESHOLD=3
WECHAT_RECONNECT_BASE_DELAY_SECONDS=5
WECHAT_RECONNECT_MAX_DELAY_SECONDS=300
WECHAT_UI_OPERATION_TIMEOUT_SECONDS=15
# Optional override when automatic executable-version detection is unavailable.
WECHAT_CLIENT_VERSION=
# Only add a version after testing receive, send, restart, and reconnect flows.
WECHAT_VERIFIED_VERSION_PREFIXES=4.1.8.107
DEDUP_WINDOW_SECONDS=60

# Keep 1 until dry-run logs look right. Set to 0 only when you are ready to send real replies.
DRY_RUN=1

# Safety guardrails
# Keep this whitelist small. Start with 文件传输助手 or a dedicated test chat.
REPLY_ALLOWED_CHATS=文件传输助手
REPLY_BLOCKED_CHATS=
REPLY_ALLOWED_SENDERS=
REPLY_BLOCKED_SENDERS=

# Only these wxauto message types can trigger replies.
TEXT_MESSAGE_TYPES=text,friend

# Required before durable voice/image files are copied. Use comma-separated Weixin cache directories.
WECHAT_MEDIA_ALLOWED_ROOTS=

# Incoming messages containing these keywords are logged for manual handling and not auto-replied.
SENSITIVE_KEYWORDS=转账,付款,收款,验证码,密码,银行卡,身份证,合同,报价,价格,地址,电话,手机号,隐私,发票,退款,投诉

# Generated replies longer than this are blocked. Use 0 to disable.
MAX_REPLY_CHARS=120

# Generated replies containing these patterns are blocked.
BLOCKED_REPLY_PATTERNS=我是AI,作为AI,我不能,无法提供,验证码,密码,银行卡,身份证,转账

# Chat policies: auto, manual, dry_run, ignore. CHAT_POLICIES uses chat=policy pairs.
DEFAULT_CHAT_POLICY=manual
CHAT_POLICIES=

# Per-chat cooldown after a generated/sent reply. Use 0 to disable.
REPLY_COOLDOWN_SECONDS=30

# In live mode, require typing YES for every generated reply before SendMsg.
REQUIRE_MANUAL_CONFIRM=1

# Manual approval mode: console asks for YES; queue writes replies to PENDING_REPLIES_FILE.
APPROVAL_MODE=console
PENDING_REPLIES_FILE=logs/pending_replies.jsonl

# Live send limits. Use 0 to disable a limit.
MAX_SENDS_PER_RUN=0
MAX_SENDS_PER_CHAT=5
MAX_SENDS_PER_DAY=100
MAX_SENDS_PER_CHAT_PER_DAY=20

# Pause the bot after this many consecutive LLM/send errors. Use 0 to disable.
MAX_ERRORS_BEFORE_PAUSE=0

# A desktop send has no acknowledgement. Retry uncertain sends only within this explicit bound.
OUTBOX_UNCERTAIN_RETRY_ENABLED=1
OUTBOX_UNCERTAIN_MAX_ATTEMPTS=3
OUTBOX_UNCERTAIN_RETRY_DELAY_SECONDS=30

# Leave empty to disable file logging.
LOG_FILE=logs/wechat-ai.log

# JSONL audit log for reply decisions. Leave empty to disable.
AUDIT_LOG_FILE=logs/audit.jsonl

# Local alert and health files for watchdog/ops. Leave empty to disable.
ALERT_FILE=logs/alerts.log
HEALTH_FILE=logs/health.json

# Rotate LOG_FILE/AUDIT_LOG_FILE/ALERT_FILE when they exceed this size. Use 0 to disable.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Daily report output directory.
REPORTS_DIR=reports

# SQLite runtime state and audit database. Leave empty to disable admin commands.
STATE_DB_FILE=data/wechat-ai.sqlite3
STATE_DB_BACKUP_RETENTION=5

# Knowledge base
KNOWLEDGE_FILE=knowledge/faq.md
KNOWLEDGE_TOP_K=3
REQUIRE_KNOWLEDGE_MATCH=0
KNOWLEDGE_FALLBACK_REPLY=这个问题我需要确认一下，稍后回复你。

# Reply style
SYSTEM_PROMPT=你是一个微信聊天助手。请根据最近上下文，生成自然、简短、像真人发送的中文回复。只输出回复正文，不要解释，不要加引号，不要输出思考过程。
