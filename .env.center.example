CENTER_DB_NAME=wechat_ai
CENTER_DB_USER=wechat_ai
CENTER_DB_PASSWORD=replace-with-a-long-random-password
CENTER_DB_PORT=5432

CENTER_DATABASE_URL=postgresql+psycopg://wechat_ai:replace-with-a-long-random-password@127.0.0.1:5432/wechat_ai
CENTER_HOST=127.0.0.1
CENTER_PORT=8790

# Generate at least 32 random bytes and keep this outside source control.
CENTER_API_KEY_PEPPER=replace-with-at-least-32-random-bytes
# During rotation, move the former current pepper here (comma-separated, max 4).
# Keep it until all Agents have heartbeated, old tokens are revoked, and prior activations expire.
CENTER_API_KEY_PREVIOUS_PEPPERS=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CENTER_SECRET_KEY=replace-with-a-fernet-key

# Shared only with the AI-cs backend. Generate with: openssl rand -hex 32
CENTER_PROVISIONING_TOKEN=replace-with-at-least-32-random-bytes

# Windows Agent binding. Fill these only on the matching Agent machine.
AGENT_CENTER_URL=https://center.example.com
AGENT_TENANT_ID=
AGENT_INSTANCE_ID=
AGENT_CHANNEL_ACCOUNT_ID=
AGENT_TOKEN=
AGENT_SPOOL_FILE=data/agent-spool.sqlite3
