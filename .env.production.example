# Copy this file to .env.production, replace every CHANGE_ME value, then chmod 600.
COMPOSE_PROJECT_NAME=change_me_project_name

# Public DNS and ACME account used by Caddy.
CENTER_DOMAIN=change_me.example.com
ACME_EMAIL=change_me@example.com

# Use lowercase letters, digits, and underscores for database names/users.
# Generate POSTGRES_PASSWORD with: openssl rand -hex 32
POSTGRES_DB=change_me_database
POSTGRES_USER=change_me_database_user
POSTGRES_PASSWORD=CHANGE_ME_WITH_64_HEX_CHARACTERS

# Generate with: openssl rand -hex 32
CENTER_API_KEY_PEPPER=CHANGE_ME_WITH_AT_LEAST_64_HEX_CHARACTERS
# Rotation only: comma-separated former peppers, newest first, maximum 4.
# Remove only after all Agents heartbeat, old credentials are revoked, and activations expire.
# CENTER_API_KEY_PREVIOUS_PEPPERS=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CENTER_SECRET_KEY=CHANGE_ME_WITH_A_FERNET_KEY

# Shared only with the AI-cs backend. Generate with: openssl rand -hex 32
CENTER_PROVISIONING_TOKEN=CHANGE_ME_WITH_AT_LEAST_64_HEX_CHARACTERS
